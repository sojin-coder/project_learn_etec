# ==============================================================================
# Application Configuration | ការកំណត់កម្មវិធី
# ==============================================================================
# Application Name | ឈ្មោះរបស់កម្មវិធីសម្រាប់បង្ហាញ
APP_NAME="PHP Basic MVC"

# Environment (local, staging, production) | បរិយាកាសដំណើរការរបស់កម្មវិធី
APP_ENV=local

# Base Application URL | URL មូលដ្ឋានសម្រាប់តំណភ្ជាប់ និង Redirect
# APP_URL=http://localhost:8080/php-mvc/PHP-MVC
APP_URL=http://localhost/learn_etec/PHP_MVC/public/

# ==============================================================================
# Database Configuration | ការកំណត់មូលដ្ឋានទិន្នន័យ
# ==============================================================================
# Database connection driver | ប្រភេទ Driver នៃ Database
DB_CONNECTION=mysql

# Database host address | អាសយដ្ឋាន Server របស់ Database
DB_HOST=127.0.0.1

# Database port | ច្រក Port របស់ Database
DB_PORT=3306

# Database schema name | ឈ្មោះ Database
DB_DATABASE=php_mvc

# Database username | ឈ្មោះអ្នកប្រើប្រាស់ Database
DB_USERNAME=root

# Database password | ពាក្យសម្ងាត់ Database
DB_PASSWORD=